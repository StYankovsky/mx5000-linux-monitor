#!/usr/bin/env bash

# Logitech MX5000 Monitor — безопасная диагностика.
# Скрипт только читает системное состояние:
# он не перезапускает монитор и не отправляет команды LCD.

set -u

APP="/usr/local/bin/mx5000-monitor"
TOOL="/usr/local/bin/mx5000-tool"

STATE_DIR="$HOME/.local/state/mx5000-monitor"
PIDFILE="$STATE_DIR/monitor.pid"
LOGFILE="$STATE_DIR/monitor.log"

OK=0
WARN=0
ERR=0

ok() {
    printf '[ OK ] %s\n' "$1"
    OK=$((OK + 1))
}

warn() {
    printf '[ !! ] %s\n' "$1"
    WARN=$((WARN + 1))
}

err() {
    printf '[FAIL] %s\n' "$1"
    ERR=$((ERR + 1))
}

section() {
    printf '\n========== %s ==========\n' "$1"
}

printf 'Logitech MX5000 Monitor — диагностика\n'
printf 'Дата: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
printf 'Пользователь: %s\n' "$(id -un)"
printf 'Режим: только чтение, без управления LCD\n'

# ------------------------------------------------------------
# 1. Проверка установленных исполняемых файлов
# ------------------------------------------------------------

section "Исполняемые файлы"

for bin in "$APP" "$TOOL"; do
    if [[ -x "$bin" && -f "$bin" ]]; then
        ok "Исполняемый файл доступен: $bin"
        ls -l "$bin"
    elif [[ -e "$bin" ]]; then
        err "Файл существует, но не исполняемый: $bin"
    else
        err "Файл не найден: $bin"
    fi
done

# ------------------------------------------------------------
# 2. Проверка библиотек mx5000-tool
# ldd анализирует зависимости, но не отправляет данные LCD.
# ------------------------------------------------------------

section "Зависимости mx5000-tool"

if [[ -x "$TOOL" ]]; then
    if command -v ldd >/dev/null 2>&1; then
        DEP_OUTPUT="$(ldd "$TOOL" 2>&1)"
        DEP_RC=$?

        printf '%s\n' "$DEP_OUTPUT"

        if [[ $DEP_RC -ne 0 ]]; then
            warn "Не удалось полностью проверить зависимости"
        elif grep -q 'not found' <<< "$DEP_OUTPUT"; then
            err "Обнаружены отсутствующие библиотеки"
        elif grep -q 'not a dynamic executable' <<< "$DEP_OUTPUT"; then
            ok "Утилита статически скомпонована или не требует динамических библиотек"
        else
            ok "Проверка зависимостей завершена: отсутствующие библиотеки не обнаружены"
        fi
    else
        warn "Команда ldd недоступна — зависимости не проверены"
    fi
else
    warn "Проверка пропущена: mx5000-tool недоступен"
fi

# ------------------------------------------------------------
# 3. Проверка процесса мониторинга и PID-файла
# ------------------------------------------------------------

section "Процесс мониторинга"

PID=""

if [[ -r "$PIDFILE" ]]; then
    read -r PID < "$PIDFILE" || PID=""

    if [[ "$PID" =~ ^[0-9]+$ ]] && kill -0 "$PID" 2>/dev/null; then
        PROC_EXE="$(readlink -f "/proc/$PID/exe" 2>/dev/null || true)"

        if [[ "$PROC_EXE" == "$APP" ]]; then
            ok "Монитор работает, PID=$PID"
            ps -p "$PID" -o pid,etime,pcpu,pmem,rss,args
            printf 'Исполняемый файл: %s\n' "$PROC_EXE"

            # Проверяем, не находится ли процесс в состоянии zombie.
            PROC_STATE="$(ps -p "$PID" -o stat= 2>/dev/null | tr -d ' ')"
            if [[ "$PROC_STATE" == Z* ]]; then
                err "Процесс находится в состоянии zombie"
            fi
        else
            warn "PID-файл указывает не на ожидаемый исполняемый файл"
            printf 'PID: %s\n' "$PID"
            printf 'Фактический файл: %s\n' "${PROC_EXE:-не определён}"
            PID=""
        fi
    else
        warn "PID-файл существует, но процесс не найден"
        printf 'PID-файл: %s\n' "$PIDFILE"
        PID=""
    fi
else
    warn "PID-файл отсутствует: $PIDFILE"
fi

# Если PID-файл отсутствует или устарел, ищем процесс отдельно.
if [[ -z "$PID" ]]; then
    if command -v pgrep >/dev/null 2>&1; then
        FOUND="$(pgrep -x mx5000-monitor 2>/dev/null || true)"

        if [[ -n "$FOUND" ]]; then
            warn "Монитор найден через pgrep, но PID-файл не подтверждает его запуск"
            while read -r P; do
                [[ -n "$P" ]] && ps -p "$P" -o pid,etime,pcpu,pmem,rss,args
            done <<< "$FOUND"
        else
            err "Запущенный процесс mx5000-monitor не найден"
        fi
    else
        warn "pgrep недоступен; дополнительный поиск процесса пропущен"
    fi
fi

# ------------------------------------------------------------
# 4. Поиск устройства Logitech MX5000
# ------------------------------------------------------------

section "Logitech MX5000 и устройства"

HID_FOUND=0

for DEV in /sys/bus/hid/devices/*; do
    [[ -e "$DEV" ]] || continue

    if [[ "$DEV" == *"0005:046D:B305."* ]]; then
        HID_FOUND=1
        ok "Найдено HID-устройство: ${DEV##*/}"

        if [[ -r "$DEV/uevent" ]]; then
            grep -E '^(DRIVER|HID_ID|HID_NAME)=' "$DEV/uevent" || true
        fi

        break
    fi
done

if [[ "$HID_FOUND" -eq 0 ]]; then
    warn "HID-устройство MX5000 сейчас не обнаружено"
    printf 'Клавиатура может быть выключена или отключена по Bluetooth.\n'
fi

# Ищем соответствующие hidraw-интерфейсы.
HIDRAW_COUNT=0

for DEV in /sys/class/hidraw/hidraw*; do
    [[ -e "$DEV" ]] || continue

    LINK="$(readlink -f "$DEV/device" 2>/dev/null || true)"

    if [[ "$LINK" == *"0005:046D:B305."* ]]; then
        HIDRAW_COUNT=$((HIDRAW_COUNT + 1))
        printf 'hidraw: /dev/%s\n' "${DEV##*/}"
    fi
done

if [[ "$HIDRAW_COUNT" -gt 0 ]]; then
    ok "Найдено hidraw-интерфейсов: $HIDRAW_COUNT"
else
    warn "hidraw-интерфейс MX5000 не найден"
fi

# Ищем input/event-интерфейсы.
INPUT_COUNT=0

for DEV in /sys/class/input/event*; do
    [[ -e "$DEV" ]] || continue

    LINK="$(readlink -f "$DEV/device" 2>/dev/null || true)"

    if [[ "$LINK" == *"0005:046D:B305."* ]]; then
        INPUT_COUNT=$((INPUT_COUNT + 1))
        printf 'input: /dev/%s\n' "${DEV##*/}"
    fi
done

if [[ "$INPUT_COUNT" -gt 0 ]]; then
    ok "Найдено input-интерфейсов: $INPUT_COUNT"
else
    warn "input/event-интерфейс MX5000 не найден"
fi

# ------------------------------------------------------------
# 5. Проверка журнала
# ------------------------------------------------------------

section "Журнал мониторинга"

if [[ -r "$LOGFILE" ]]; then
    ok "Журнал доступен: $LOGFILE"

    printf '\n--- Последние 20 строк ---\n'
    tail -n 20 "$LOGFILE"

    printf '\n--- Подозрительные сообщения в журнале ---\n'

    matches=$(grep -Ein \
        'error|failed|failure|fatal|cannot|unable|segmentation fault|permission denied' \
        "$LOGFILE" || true)

    if [ -n "$matches" ]; then
        printf '%s\n' "$matches" | tail -n 15
        warn "В журнале есть строки, требующие проверки"
    else
        ok "Типичные сообщения об ошибках не обнаружены"
    fi

    printf '\n--- Сводка журнала ---\n'
    printf 'Строк всего: '
    wc -l < "$LOGFILE"

    printf 'Выборов страниц: '
    grep -c 'Selected page' "$LOGFILE" || true

    printf 'Запусков монитора: '
    grep -c 'MX5000 Monitor starting' "$LOGFILE" || true

    printf 'Остановок монитора: '
    grep -c 'MX5000 Monitor stopped' "$LOGFILE" || true
else
    warn "Журнал отсутствует или недоступен: $LOGFILE"
fi

# ------------------------------------------------------------
# 6. Итог
# ------------------------------------------------------------

section "Итог"

printf 'Успешно:      %s\n' "$OK"
printf 'Предупреждения: %s\n' "$WARN"
printf 'Ошибки:       %s\n' "$ERR"

if [[ "$ERR" -gt 0 ]]; then
    printf '\nРезультат: обнаружены ошибки. Изучи сообщения выше.\n'
    exit 2
elif [[ "$WARN" -gt 0 ]]; then
    printf '\nРезультат: есть предупреждения. Проверь их причины.\n'
    exit 1
else
    printf '\nРезультат: все автоматические проверки пройдены.\n'
fi

printf '\nВажно: реальное обновление изображения на LCD этой проверкой не подтверждается.\n'
exit 0
